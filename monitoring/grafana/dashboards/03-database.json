{
  "title": "Database (Postgres) Overview",
  "uid": "database-overview",
  "tags": ["advanced-devops", "database"],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "30s",
  "time": { "from": "now-1h", "to": "now" },
  "description": "This demo monitors Postgres via standard container/kubelet metrics rather than a postgres_exporter sidecar, to keep the local resource footprint small - see docs/architecture.md. A real production deployment would add postgres_exporter for query-level metrics (connections, replication lag, slow queries).",
  "templating": {
    "list": [
      {
        "name": "namespace",
        "type": "query",
        "datasource": { "type": "prometheus", "uid": "prometheus" },
        "query": "label_values(kube_pod_status_phase{pod=~\"postgres-.*\"}, namespace)",
        "refresh": 2,
        "includeAll": true,
        "multi": true
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "title": "Postgres pod status",
      "type": "stat",
      "gridPos": { "h": 6, "w": 8, "x": 0, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        {
          "expr": "sum(kube_pod_status_phase{namespace=~\"$namespace\", pod=~\"postgres-.*\", phase=\"Running\"}) by (namespace)",
          "legendFormat": "{{namespace}}"
        }
      ]
    },
    {
      "id": 2,
      "title": "Postgres pod restarts (total)",
      "type": "stat",
      "gridPos": { "h": 6, "w": 8, "x": 8, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        {
          "expr": "sum(kube_pod_container_status_restarts_total{namespace=~\"$namespace\", pod=~\"postgres-.*\"}) by (namespace)",
          "legendFormat": "{{namespace}}"
        }
      ]
    },
    {
      "id": 3,
      "title": "Data volume usage",
      "type": "gauge",
      "gridPos": { "h": 6, "w": 8, "x": 16, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "percentunit", "max": 1, "min": 0 }, "overrides": [] },
      "targets": [
        {
          "expr": "max(kubelet_volume_stats_used_bytes{namespace=~\"$namespace\", persistentvolumeclaim=~\"postgres-storage-.*\"} / kubelet_volume_stats_capacity_bytes{namespace=~\"$namespace\", persistentvolumeclaim=~\"postgres-storage-.*\"}) by (namespace)",
          "legendFormat": "{{namespace}}"
        }
      ]
    },
    {
      "id": 4,
      "title": "Postgres CPU usage",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 6 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        {
          "expr": "sum(rate(container_cpu_usage_seconds_total{namespace=~\"$namespace\", pod=~\"postgres-.*\", container=\"postgres\"}[5m])) by (namespace)",
          "legendFormat": "{{namespace}}"
        }
      ]
    },
    {
      "id": 5,
      "title": "Postgres memory usage",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 6 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "bytes" }, "overrides": [] },
      "targets": [
        {
          "expr": "sum(container_memory_working_set_bytes{namespace=~\"$namespace\", pod=~\"postgres-.*\", container=\"postgres\"}) by (namespace)",
          "legendFormat": "{{namespace}}"
        }
      ]
    }
  ]
}
