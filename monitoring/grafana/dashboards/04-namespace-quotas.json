{
  "title": "Namespace Resource Quotas",
  "uid": "namespace-quotas",
  "tags": ["advanced-devops", "cost", "capacity"],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "30s",
  "time": { "from": "now-6h", "to": "now" },
  "description": "Tracks each environment's actual resource usage against the Terraform-defined ResourceQuota for that namespace - the same numbers behind the cost analysis document (docs/cost-analysis.md).",
  "panels": [
    {
      "id": 1,
      "title": "CPU requests used vs quota (by namespace)",
      "type": "timeseries",
      "gridPos": { "h": 9, "w": 12, "x": 0, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "short" }, "overrides": [] },
      "targets": [
        {
          "expr": "kube_resourcequota{namespace=~\"development|staging|production\", resource=\"requests.cpu\", type=\"used\"}",
          "legendFormat": "{{namespace}} used"
        },
        {
          "expr": "kube_resourcequota{namespace=~\"development|staging|production\", resource=\"requests.cpu\", type=\"hard\"}",
          "legendFormat": "{{namespace}} hard limit"
        }
      ]
    },
    {
      "id": 2,
      "title": "Memory requests used vs quota (by namespace)",
      "type": "timeseries",
      "gridPos": { "h": 9, "w": 12, "x": 12, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "bytes" }, "overrides": [] },
      "targets": [
        {
          "expr": "kube_resourcequota{namespace=~\"development|staging|production\", resource=\"requests.memory\", type=\"used\"}",
          "legendFormat": "{{namespace}} used"
        },
        {
          "expr": "kube_resourcequota{namespace=~\"development|staging|production\", resource=\"requests.memory\", type=\"hard\"}",
          "legendFormat": "{{namespace}} hard limit"
        }
      ]
    },
    {
      "id": 3,
      "title": "Pod count vs max pods (by namespace)",
      "type": "bargauge",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 9 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        {
          "expr": "kube_resourcequota{namespace=~\"development|staging|production\", resource=\"pods\", type=\"used\"}",
          "legendFormat": "{{namespace}}"
        }
      ]
    },
    {
      "id": 4,
      "title": "Total pods by namespace",
      "type": "piechart",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 9 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        {
          "expr": "sum(kube_pod_status_phase{namespace=~\"development|staging|production\", phase=\"Running\"}) by (namespace)",
          "legendFormat": "{{namespace}}"
        }
      ]
    }
  ]
}
